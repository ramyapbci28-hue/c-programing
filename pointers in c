
#include <stdlib.h> // Required for the abs() function

void update(int *a, int *b) {
    int old_a = *a;
    int old_b = *b;
    
    // Set a to the sum of both values
    *a = old_a + old_b;
    
    // Set b to the absolute difference of both values
    *b = abs(old_a - old_b);
}

int main() {
    int a, b;
    int *pa = &a, *pb = &b;
    
    if (scanf("%d %d", &a, &b) == 2) {
        update(pa, pb);
        printf("%d\n%d\n", a, b);
    }
    return 0;
}

