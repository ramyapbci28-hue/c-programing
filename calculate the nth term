#include <stdio.h>

// Recursive function to find the nth term
int find_nth_term(int n, int a, int b, int c) {
    // Base Case 1: If n is 1, return the first term 'a'
    if (n == 1) {
        return a;
    }
    // Base Case 2: If n is 2, return the second term 'b'
    if (n == 2) {
        return b;
    }
    // Base Case 3: If n is 3, return the third term 'c'
    if (n == 3) {
        return c;
    }
    
    // Recursive Case: Sum of the previous three terms
    return find_nth_term(n - 1, a, b, c) + 
           find_nth_term(n - 2, a, b, c) + 
           find_nth_term(n - 3, a, b, c);
}

