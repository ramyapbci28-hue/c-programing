
#include <string.h>
#include <stdlib.h>

bool isValid(char* s) {
    int len = strlen(s);
    
    // Allocate space for the stack. In the worst case, 
    // all characters are opening brackets.
    char* stack = (char*)malloc(len * sizeof(char));
    int top = -1;
    
    for (int i = 0; i < len; i++) {
        char current = s[i];
        
        // If it's an opening bracket, push it onto the stack
        if (current == '(' || current == '{' || current == '[') {
            stack[++top] = current;
        } 
        // If it's a closing bracket, check for matching opening bracket
        else {
            // Stack is empty means no matching opening bracket
            if (top == -1) {
                free(stack);
                return false;
            }
            
            char open = stack[top--];
            if ((current == ')' && open != '(') ||
                (current == '}' && open != '{') ||
                (current == ']' && open != '[')) {
                free(stack);
                return false;
            }
        }
    }
    
    // If the stack is empty, all brackets were properly matched
    bool result = (top == -1);
    free(stack);
    return result;
}
