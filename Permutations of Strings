int next_permutation(int n, char **s) {
    // Step 1: Find the longest non-increasing suffix from the right
    int i = n - 1;
    while (i > 0 && strcmp(s[i - 1], s[i]) >= 0) {
        i--;
    }
    
    // If the entire array is sorted in descending order, no next permutation exists
    if (i <= 0) {
        return 0;
    }
    
    // Step 2: Identify the pivot element (s[i - 1]) and find the rightmost successor in the suffix
    int j = n - 1;
    while (strcmp(s[i - 1], s[j]) >= 0) {
        j--;
    }
    
    // Step 3: Swap the pivot element with its successor
    char *temp = s[i - 1];
    s[i - 1] = s[j];
    s[j] = temp;
    
    // Step 4: Reverse the suffix elements to make it the lowest possible order
    j = n - 1;
    while (i < j) {
        temp = s[i];
        s[i] = s[j];
        s[j] = temp;
        i++;
        j--;
    }
    
    return 1; // Successfully modified array to its next permutation
}

