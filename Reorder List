
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */

void reorderList(struct ListNode* head) {
    if (!head || !head->next || !head->next->next) {
        return;
    }

    // Step 1: Find the middle of the linked list
    struct ListNode *slow = head;
    struct ListNode *fast = head;
    
    while (fast->next && fast->next->next) {
        slow = slow->next;
        fast = fast->next->next;
    }
    
    // slow->next is the start of the second half
    struct ListNode *secondHalf = slow->next;
    slow->next = NULL; // Split the list into two halves

    // Step 2: Reverse the second half
    struct ListNode *prev = NULL;
    struct ListNode *curr = secondHalf;
    struct ListNode *next = NULL;
    
    while (curr) {
        next = curr->next;
        curr->next = prev;
        prev = curr;
        curr = next;
    }
    // prev now points to the head of the reversed second half
    struct ListNode *firstHalf = head;
    secondHalf = prev;

    // Step 3: Merge the two halves alternately
    while (secondHalf) {
        struct ListNode *temp1 = firstHalf->next;
        struct ListNode *temp2 = secondHalf->next;
        
        firstHalf->next = secondHalf;
        secondHalf->next = temp1;
        
        firstHalf = temp1;
        secondHalf = temp2;
    }
}
