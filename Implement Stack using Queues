
#include <stdlib.h>

#define MAX_SIZE 100

// --- Simple Queue Implementation Helper ---
typedef struct {
    int data[MAX_SIZE];
    int front;
    int rear;
    int size;
} Queue;

Queue* createQueue() {
    Queue* q = (Queue*)malloc(sizeof(Queue));
    q->front = 0;
    q->rear = -1;
    q->size = 0;
    return q;
}

void enqueue(Queue* q, int x) {
    if (q->size >= MAX_SIZE) return;
    q->rear = (q->rear + 1) % MAX_SIZE;
    q->data[q->rear] = x;
    q->size++;
}

int dequeue(Queue* q) {
    if (q->size == 0) return -1;
    int val = q->data[q->front];
    q->front = (q->front + 1) % MAX_SIZE;
    q->size--;
    return val;
}

int peekQueue(Queue* q) {
    if (q->size == 0) return -1;
    return q->data[q->front];
}

bool isQueueEmpty(Queue* q) {
    return q->size == 0;
}

void freeQueue(Queue* q) {
    free(q);
}


// --- MyStack Implementation ---
typedef struct {
    Queue* q1; // Primary queue storing the stack elements
    Queue* q2; // Auxiliary queue used for rearrangement
} MyStack;

/** Initializes your data structure here. */
MyStack* myStackCreate() {
    MyStack* stack = (MyStack*)malloc(sizeof(MyStack));
    stack->q1 = createQueue();
    stack->q2 = createQueue();
    return stack;
}

/** Pushes element x to the top of the stack. */
void myStackPush(MyStack* obj, int x) {
    // 1. Put the new element into q2
    enqueue(obj->q2, x);
    
    // 2. Move all elements from q1 to q2
    while (!isQueueEmpty(obj->q1)) {
        enqueue(obj->q2, dequeue(obj->q1));
    }
    
    // 3. Swap q1 and q2 so that q1 contains the updated stack
    Queue* temp = obj->q1;
    obj->q1 = obj->q2;
    obj->q2 = temp;
}

/** Removes the element on the top of the stack and returns it. */
int myStackPop(MyStack* obj) {
    return dequeue(obj->q1);
}

/** Returns the element on the top of the stack. */
int myStackTop(MyStack* obj) {
    return peekQueue(obj->q1);
}

/** Returns whether the stack is empty. */
bool myStackEmpty(MyStack* obj) {
    return isQueueEmpty(obj->q1);
}

/** Deallocates the stack memory. */
void myStackFree(MyStack* obj) {
    freeQueue(obj->q1);
    freeQueue(obj->q2);
    free(obj);
}
