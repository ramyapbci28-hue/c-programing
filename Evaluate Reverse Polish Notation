
#include <stdlib.h>
#include <string.h>

int evalRPN(char** tokens, int tokensSize) {
    // Allocate a stack large enough for all tokens
    int* stack = (int*)malloc(tokensSize * sizeof(int));
    int top = -1;

    for (int i = 0; i < tokensSize; i++) {
        char* token = tokens[i];

        // Check if the token is an operator and has length 1
        // (Note: negative numbers like "-11" have length > 1, so we check token[1] == '\0')
        if ((token[0] == '+' || token[0] == '-' || token[0] == '*' || token[0] == '/') && token[1] == '\0') {
            int b = stack[top--]; // Second operand
            int a = stack[top--]; // First operand

            switch (token[0]) {
                case '+': stack[++top] = a + b; break;
                case '-': stack[++top] = a - b; break;
                case '*': stack[++top] = a * b; break;
                case '/': stack[++top] = a / b; break; // C integer division automatically truncates toward zero
            }
        } else {
            // Token is a number, convert string to integer and push
            stack[++top] = atoi(token);
        }
    }

    int result = stack[top];
    free(stack); // Clean up allocated memory
    return result;
}
