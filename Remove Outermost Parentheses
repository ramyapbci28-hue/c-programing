#include <stdlib.h>
#include <string.h>

char* removeOuterParentheses(char* s) {
    int len = strlen(s);
    // Allocate memory for the result string (at most the same length as s)
    char* result = (char*)malloc((len + 1) * sizeof(char));
    
    int opened = 0; // Tracks the depth of open parentheses
    int index = 0;  // Index for writing into the result string
    
    for (int i = 0; i < len; i++) {
        if (s[i] == '(') {
            // If opened > 0, this '(' is not an outermost parenthesis
            if (opened > 0) {
                result[index++] = s[i];
            }
            opened++;
        } else if (s[i] == ')') {
            opened--;
            // If opened > 0, this ')' is not an outermost parenthesis
            if (opened > 0) {
                result[index++] = s[i];
            }
        }
    }
    
    // Null-terminate the string
    result[index] = '\0';
    
    return result;
}
