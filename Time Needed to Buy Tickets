int timeRequiredToBuy(int* tickets, int ticketsSize, int k) {
    int total_time = 0;
    int target_tickets = tickets[k];
    
    for (int i = 0; i < ticketsSize; i++) {
        if (i <= k) {
            // People before or at index k
            total_time += (tickets[i] < target_tickets) ? tickets[i] : target_tickets;
        } else {
            // People after index k
            total_time += (tickets[i] < target_tickets - 1) ? tickets[i] : (target_tickets - 1);
        }
    }
    
    return total_time;
}
