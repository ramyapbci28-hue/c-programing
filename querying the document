#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include<assert.h>
#define MAX_CHARACTERS 1005
#define MAX_PARAGRAPHS 5

// --- Implementations of the required functions ---

char**** get_document(char* text) {
    // 4D structure: document -> paragraph -> sentence -> word (char*)
    char**** doc = NULL;
    int p_count = 0;
    
    // Duplicate text to use strtok safely
    char* text_copy = strdup(text);
    
    // Tokenize text into paragraphs using newline '\n'
    char* p_save;
    char* p_token = strtok_r(text_copy, "\n", &p_save);
    
    while (p_token != NULL) {
        p_count++;
        doc = realloc(doc, p_count * sizeof(char***));
        
        char*** paragraph = NULL;
        int s_count = 0;
        
        // Tokenize paragraph into sentences using period '.'
        char* s_save;
        char* s_token = strtok_r(p_token, ".", &s_save);
        
        while (s_token != NULL) {
            s_count++;
            paragraph = realloc(paragraph, s_count * sizeof(char**));
            
            char** sentence = NULL;
            int w_count = 0;
            
            // Tokenize sentence into words using space ' '
            char* w_save;
            char* w_token = strtok_r(s_token, " ", &w_save);
            
            while (w_token != NULL) {
                w_count++;
                sentence = realloc(sentence, w_count * sizeof(char*));
                sentence[w_count - 1] = strdup(w_token);
                
                w_token = strtok_r(NULL, " ", &w_save);
            }
            
            paragraph[s_count - 1] = sentence;
            s_token = strtok_r(NULL, ".", &s_save);
        }
        
        doc[p_count - 1] = paragraph;
        p_token = strtok_r(NULL, "\n", &p_save);
    }
    
    free(text_copy);
    return doc;
}

char*** kth_paragraph(char**** document, int k) {
    // 1-indexed query: return the (k-1)-th index paragraph
    return document[k - 1];
}

char** kth_sentence_in_mth_paragraph(char**** document, int k, int m) {
    // 1-indexed query: return the (k-1)-th sentence in the (m-1)-th paragraph
    return document[m - 1][k - 1];
}

char* kth_word_in_mth_sentence_of_nth_paragraph(char**** document, int k, int m, int n) {
    // 1-indexed query: return the (k-1)-th word in the (m-1)-th sentence of the (n-1)-th paragraph
    return document[n - 1][m - 1][k - 1];
}

