

int maxResult(int* nums, int numsSize, int k) {
    if (numsSize == 0) return 0;
    
    // dp[i] stores the maximum score to reach index i
    int* dp = (int*)malloc(numsSize * sizeof(int));
    
    // deque will store indices of the dp array
    int* deque = (int*)malloc(numsSize * sizeof(int));
    int head = 0; // Front of the deque
    int tail = 0; // Back of the deque
    
    // Base case: starting at index 0
    dp[0] = nums[0];
    deque[tail++] = 0; // Push index 0 to deque
    
    for (int i = 1; i < numsSize; i++) {
        // 1. Remove indices that are out of the window [i - k, i - 1]
        if (deque[head] < i - k) {
            head++;
        }
        
        // 2. The maximum value in the current window is at the front of the deque
        dp[i] = nums[i] + dp[deque[head]];
        
        // 3. Maintain monotonic decreasing order in the deque.
        // Remove indices from the back whose dp values are less than or equal to dp[i]
        while (tail > head && dp[deque[tail - 1]] <= dp[i]) {
            tail--;
        }
        
        // 4. Add the current index to the back of the deque
        deque[tail++] = i;
    }
    
    int result = dp[numsSize - 1];
    
    // Free allocated memory
    free(dp);
    free(deque);
    
    return result;
}
