#include <stdlib.h>
#include <math.h>

struct triangle
{
	int a;
	int b;
	int c;
};

typedef struct triangle triangle;
// Helper function to calculate 16 * (Area squared) to keep everything as integers
long long get_squared_area(triangle tr) {
    long long a = tr.a;
    long long b = tr.b;
    long long c = tr.c;
    // 16 * Area^2 = (a + b + c) * (a + b - c) * (a - b + c) * (-a + b + c)
    return (a + b + c) * (a + b - c) * (a - b + c) * (-a + b + c);
}

// Function to sort the triangles by area using Bubble Sort
void sort_by_area(triangle* tr, int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (get_squared_area(tr[j]) > get_squared_area(tr[j + 1])) {
                // Swap the structures
                triangle temp = tr[j];
                tr[j] = tr[j + 1];
                tr[j + 1] = temp;
            }
        }
    }
}


