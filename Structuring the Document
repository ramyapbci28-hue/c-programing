
#include <stdlib.h>
#include <string.h>
#include <assert.h>
#define MAX_CHARACTERS 1005
#define MAX_PARAGRAPHS 5

struct word {
    char* data;
};

struct sentence {
    struct word* data;
    int word_count;//denotes number of words in a sentence
};

struct paragraph {
    struct sentence* data  ;
    int sentence_count;//denotes number of sentences in a paragraph
};

struct document {
    struct paragraph* data;
    int paragraph_count;//denotes number of paragraphs in a document
};

struct document get_document(char* text) {
    struct document doc;
    doc.data = NULL;
    doc.paragraph_count = 0;

    struct paragraph *cur_paragraph = NULL;
    struct sentence *cur_sentence = NULL;
    char *new_word = NULL;
    
    int w_len = 0;

    for (char *s = text; ; ++s) {
        if (*s == ' ' || *s == '.' || *s == '\n' || *s == '\0') {
            if (w_len > 0) {
                // Add the collected word to the current sentence
                cur_sentence->word_count++;
                cur_sentence->data = realloc(cur_sentence->data, cur_sentence->word_count * sizeof(struct word));
                
                new_word = malloc((w_len + 1) * sizeof(char));
                strncpy(new_word, s - w_len, w_len);
                new_word[w_len] = '\0';
                
                cur_sentence->data[cur_sentence->word_count - 1].data = new_word;
                w_len = 0;
            }

            if (*s == '.') {
                // Prepare next sentence array space if there is one
                if (*(s + 1) != '\n' && *(s + 1) != '\0') {
                    cur_paragraph->sentence_count++;
                    cur_paragraph->data = realloc(cur_paragraph->data, cur_paragraph->sentence_count * sizeof(struct sentence));
                    cur_sentence = &cur_paragraph->data[cur_paragraph->sentence_count - 1];
                    cur_sentence->data = NULL;
                    cur_sentence->word_count = 0;
                }
            } 
            else if (*s == '\n' || *s == '\0') {
                if (*s == '\0') {
                    break;
                }
                // Prepare space for the next paragraph array block
                doc.paragraph_count++;
                doc.data = realloc(doc.data, doc.paragraph_count * sizeof(struct paragraph));
                cur_paragraph = &doc.data[doc.paragraph_count - 1];
                cur_paragraph->sentence_count = 1;
                cur_paragraph->data = malloc(sizeof(struct sentence));
                
                cur_sentence = &cur_paragraph->data[0];
                cur_sentence->data = NULL;
                cur_sentence->word_count = 0;
            }
        } 
        else {
            // Document bootstrap checks
            if (doc.data == NULL) {
                doc.paragraph_count = 1;
                doc.data = malloc(sizeof(struct paragraph));
                cur_paragraph = &doc.data[0];
                cur_paragraph->sentence_count = 1;
                cur_paragraph->data = malloc(sizeof(struct sentence));
                cur_sentence = &cur_paragraph->data[0];
                cur_sentence->data = NULL;
                cur_sentence->word_count = 0;
            }
            w_len++;
        }
    }
    return doc;
}

struct paragraph kth_paragraph(struct document Doc, int k) {
    return Doc.data[k - 1];
}

struct sentence kth_sentence_in_mth_paragraph(struct document Doc, int k, int m) {
    return Doc.data[m - 1].data[k - 1];
}

struct word kth_word_in_mth_sentence_of_nth_paragraph(struct document Doc, int k, int m, int n) {
    return Doc.data[n - 1].data[m - 1].data[k - 1];
}

