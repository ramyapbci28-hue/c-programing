#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() 
{
    char ch;
    char s[100];
    char sen[100];

    // 1. Read the single character
    scanf("%c", &ch);

    // 2. Read the string (stops at the first whitespace)
    scanf("%s", s);

    // 3. Clean the buffer newline and read the sentence (stops at newline)
    scanf("\n");
    scanf("%[^\n]%*c", sen);

    // 4. Print the outputs on separate lines
    printf("%c\n", ch);
    printf("%s\n", s);
    printf("%s\n", sen);
    
    return 0;
}
