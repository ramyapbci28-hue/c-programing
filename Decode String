
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

char* decodeString(char* s) {
    // Maximum guaranteed length of the output is 10^5
    int max_len = 100005;
    char* res = (char*)malloc(max_len * sizeof(char));
    int res_len = 0;

    // Stacks to track repeat counts and starting indices of brackets
    int countStack[1000];
    int indexStack[1000];
    int top = 0;

    int i = 0;
    while (s[i] != '\0') {
        if (isdigit(s[i])) {
            // Parse the multi-digit number k
            int k = 0;
            while (isdigit(s[i])) {
                k = k * 10 + (s[i] - '0');
                i++;
            }
            countStack[top] = k;
        } 
        else if (s[i] == '[') {
            // Save the current result length as the start index for this bracket level
            indexStack[top] = res_len;
            top++;
            i++;
        } 
        else if (s[i] == ']') {
            top--;
            int k = countStack[top];
            int start_idx = indexStack[top];
            int segment_len = res_len - start_idx;

            // Duplicate the substring (k - 1) times at the end of the buffer
            for (int r = 0; r < k - 1; r++) {
                memcpy(&res[res_len], &res[start_idx], segment_len);
                res_len += segment_len;
            }
            i++;
        } 
        else {
            // Normal characters are simply appended to the buffer
            res[res_len++] = s[i];
            i++;
        }
    }

    res[res_len] = '\0'; // Null-terminate the final decoded string
    return res;
}
