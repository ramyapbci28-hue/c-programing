struct box {
    int length;
    int width;
    int height;
};

// Create a typedef so we can use 'box' directly as a type
typedef struct box box;

// 2. Implement get_volume function
int get_volume(box b) {
    return b.length * b.width * b.height;
}

// 3. Implement is_lower_than_max_height function
