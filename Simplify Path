
#include <string.h>
#include <stdlib.h>

char* simplifyPath(char* path) {
    int len = strlen(path);
    
    // Stack to store valid directory names
    // Max possible components cannot exceed len / 2
    char** stack = (char**)malloc(sizeof(char*) * (len / 2 + 1));
    int top = 0;
    
    // Tokenize the path using '/' as the delimiter
    char* token = strtok(path, "/");
    
    while (token != NULL) {
        if (strcmp(token, ".") == 0 || strcmp(token, "") == 0) {
            // '.' represents the current directory, do nothing
        } else if (strcmp(token, "..") == 0) {
            // '..' means move up one level; pop from stack if not empty
            if (top > 0) {
                top--;
            }
        } else {
            // Valid directory name (including things like "...")
            stack[top++] = token;
        }
        token = strtok(NULL, "/");
    }
    
    // Allocate memory for the final canonical path result
    char* result = (char*)malloc(sizeof(char) * (len + 1));
    result[0] = '\0';
    
    // Reconstruct the path from the stack elements
    if (top == 0) {
        strcpy(result, "/");
    } else {
        for (int i = 0; i < top; i++) {
            strcat(result, "/");
            strcat(result, stack[i]);
        }
    }
    
    free(stack);
    return result;
}
