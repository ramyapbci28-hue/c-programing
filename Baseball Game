
#include <string.h>

int calPoints(char** operations, int operationsSize) {
    // Dynamically allocate a stack to hold the scores
    int* stack = (int*)malloc(sizeof(int) * operationsSize);
    int top = -1; // Index tracker for the top of the stack

    for (int i = 0; i < operationsSize; i++) {
        if (strcmp(operations[i], "C") == 0) {
            // Remove the last score
            if (top >= 0) {
                top--;
            }
        } else if (strcmp(operations[i], "D") == 0) {
            // Record a new score that is double the previous score
            top++;
            stack[top] = stack[top - 1] * 2;
        } else if (strcmp(operations[i], "+") == 0) {
            // Record a new score that is the sum of the previous two scores
            top++;
            stack[top] = stack[top - 1] + stack[top - 2];
        } else {
            // Convert the string integer to an actual int and record it
            top++;
            stack[top] = atoi(operations[i]);
        }
    }

    // Sum all the values currently in the stack
    int totalSum = 0;
    for (int i = 0; i <= top; i++) {
        totalSum += stack[i];
    }

    // Free allocated memory to prevent memory leaks
    free(stack);

    return totalSum;
}
