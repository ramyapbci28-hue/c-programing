
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

// Helper function to find the maximum subsequence of size 'k' from an array
int* maxSubarray(int* nums, int numsSize, int k) {
    int* res = (int*)malloc(k * sizeof(int));
    int top = 0; // Pointer for the stack position
    int drop = numsSize - k; // Total elements we are allowed to drop
    
    for (int i = 0; i < numsSize; i++) {
        while (top > 0 && res[top - 1] < nums[i] && drop > 0) {
            top--;
            drop--;
        }
        if (top < k) {
            res[top++] = nums[i];
        } else {
            drop--;
        }
    }
    return res;
}

// Helper function to compare which array suffix is larger
bool greater(int* nums1, int i, int size1, int* nums2, int j, int size2) {
    while (i < size1 && j < size2) {
        if (nums1[i] > nums2[j]) return true;
        if (nums1[i] < nums2[j]) return false;
        i++;
        j++;
    }
    return i < size1;
}

// Helper function to merge two subsequences into the maximum possible combined array
int* merge(int* sub1, int size1, int* sub2, int size2) {
    int k = size1 + size2;
    int* res = (int*)malloc(k * sizeof(int));
    int i = 0, j = 0, r = 0;
    
    while (i < size1 || j < size2) {
        if (greater(sub1, i, size1, sub2, j, size2)) {
            res[r++] = sub1[i++];
        } else {
            res[r++] = sub2[j++];
        }
    }
    return res;
}

// Main function required by LeetCode
int* maxNumber(int* nums1, int nums1Size, int* nums2, int nums2Size, int k, int* returnSize) {
    *returnSize = k;
    int* maxRes = (int*)calloc(k, sizeof(int));
    
    // Determine bounds for elements to pick from nums1
    int start = (k - nums2Size > 0) ? k - nums2Size : 0;
    int end = (k < nums1Size) ? k : nums1Size;
    
    for (int i = start; i <= end; i++) {
        int* sub1 = maxSubarray(nums1, nums1Size, i);
        int* sub2 = maxSubarray(nums2, nums2Size, k - i);
        int* merged = merge(sub1, i, sub2, k - i);
        
        // If the newly merged combination is larger than the global max, update maxRes
        if (greater(merged, 0, k, maxRes, 0, k)) {
            memcpy(maxRes, merged, k * sizeof(int));
        }
        
        free(sub1);
        free(sub2);
        free(merged);
    }
    
    return maxRes;
}
