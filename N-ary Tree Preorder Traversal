
 * Definition for a Node.
 * struct Node {
 *     int val;
 *     int numChildren;
 *     struct Node** children;
 * };
 */

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
void traverse(struct Node* root, int* result, int* index) {
    if (root == NULL) {
        return;
    }
    
    // Visit the root node
    result[(*index)++] = root->val;
    
    // Traverse all children from left to right
    for (int i = 0; i < root->numChildren; i++) {
        traverse(root->children[i], result, index);
    }
}

int* preorder(struct Node* root, int* returnSize) {
    // According to LeetCode constraints, the maximum number of nodes is 10,000
    int* result = (int*)malloc(10000 * sizeof(int));
    *returnSize = 0;
    
    traverse(root, result, returnSize);
    
    return result;
}
