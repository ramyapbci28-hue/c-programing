
#include <string.h>
#include <math.h>
#include <stdlib.h>
// Function to calculate the sum of marks based on gender
int marks_summation(int* marks, int number_of_students, char gender) {
    int sum = 0;
    
    // Determine the starting index based on gender
    // Boys are at even indices (0, 2, 4...)
    // Girls are at odd indices (1, 3, 5...)
    int start_index = (gender == 'b') ? 0 : 1;
    
    // Loop through the array, incrementing by 2 to skip alternating genders
    for (int i = start_index; i < number_of_students; i += 2) {
        sum += *(marks + i);
    }
    
    return sum;
}

